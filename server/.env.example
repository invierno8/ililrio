# טוקן GitHub עם הרשאת כתיבה ל-contents של הרפו הזה בלבד
GITHUB_TOKEN=
GITHUB_REPO=invierno8/ililrio
GITHUB_BRANCH=main

# מחרוזת אקראית לחתימת סשנים (openssl rand -hex 32)
JYNX_SESSION_SECRET=

# סיסמאות המנהלים; ריק = ברירת המחדל הזמנית (rio=2222, ilil=1111)
JYNX_PASSWORD_RIO=
JYNX_PASSWORD_ILIL=

# סיסמה למעירים רגילים; ריק = כניסה עם שם בלבד
JYNX_REVIEWER_PASSWORD=

ALLOWED_ORIGINS=https://invierno8.github.io
